---
import Section from './Section.astro';
import ButtonRow from './ButtonRow.astro';
import Badge from './Badge.astro';
import pixelMark from '../images/neuron-iq-logo.svg';
import pixelMarkDark from '../images/neuron-iq-logo-dark.svg';
import premiumMark from '../images/neuron-iq-premium-logo.svg';
import premiumMarkDark from '../images/neuron-iq-premium-logo-dark.svg';
import { slugify } from '../utils/format';

interface Props {
  title: string;
  lead?: string;
  /** Stacked above the title, e.g. "Coming soon" */
  badge?: string;
  /** 1 for the hero that opens a page, 2 for the call to action that closes it */
  level?: 1 | 2;
  dark?: boolean;
  /** Neuron IQ Premium: the pixel mark with its blue square */
  product?: 'premium';
  id?: string;
}

// Slots: the default slot takes the buttons, and `below-buttons` what follows
// them. The `visual` slot replaces the pixel mark, and is shown on phones too.
const { title, lead, badge, level = 1, dark = false, product, id } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
const titleId = `${id ?? slugify(title)}-title`;
const marks = {
  iq: { light: pixelMark, dark: pixelMarkDark },
  premium: { light: premiumMark, dark: premiumMarkDark },
};
const mark = marks[product ?? 'iq'][dark ? 'dark' : 'light'];
const hasVisual = Astro.slots.has('visual');
---

<Section id={id} tone={dark ? 'dark' : undefined} labelledby={titleId}>
  <div class:list={['grid', { 'with-visual': hasVisual }]}>
    <div class="copy">
      {
        badge ? (
          <div class="title">
            <Badge>{badge}</Badge>
            <Heading class="title-xl" id={titleId}>{title}</Heading>
          </div>
        ) : (
          <Heading class="title-xl" id={titleId}>{title}</Heading>
        )
      }
      {lead && <p class="text-lead lead">{lead}</p>}
      <ButtonRow class="actions"><slot /></ButtonRow>
      <slot name="below-buttons" />
    </div>
    {
      hasVisual ? (
        <div class="visual">
          <slot name="visual" />
        </div>
      ) : (
        <img class="mark" src={mark.src} width={mark.width} height={mark.height} alt="" />
      )
    }
  </div>
</Section>

<style lang="scss">
  @use "../styles/variables/breakpoints" as bp;

  .grid {
    display: grid;
    gap: var(--s-40);
    align-items: center;

    @include bp.up(md) {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--s-32);
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-36);

    @include bp.up(md) {
      grid-column: 1 / span 8;
    }
  }

  .title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-16);
  }

  .lead {
    max-width: var(--measure-m);
  }

  // Full width, so phone-wide buttons span the copy column
  .actions {
    align-self: stretch;
  }

  // The square ornament: desktop only
  .mark {
    display: none;
    width: 100%;
    max-width: var(--pixel-mark-size);
    height: auto;
    justify-self: end;

    @include bp.up(md) {
      display: block;
      grid-column: 10 / span 3;
    }
  }

  .visual {
    width: 100%;
    max-width: var(--scene-max-width);
  }

  @include bp.up(md) {
    .with-visual .copy {
      grid-column: 1 / span 7;
    }

    .with-visual .visual {
      grid-column: 8 / span 5;
      max-width: none;
    }
  }
</style>
