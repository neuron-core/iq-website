---
import { PAGES } from '../consts/links';

interface Props {
  size?: 'm' | 'xl';
  class?: string;
}

const { size = 'm', class: className } = Astro.props;
---

<a class:list={['logo', { xl: size === 'xl' }, className]} href={PAGES.home}>Neuron <span class="iq">IQ</span></a>

<style lang="scss">
  @use "../styles/variables/breakpoints" as bp;

  // The wordmark only, "IQ" in brand green
  .logo {
    display: inline-block;
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-size: var(--heading-s-size);
    font-weight: var(--font-weight-medium);
    line-height: var(--heading-s-line);
    text-decoration: none;
    white-space: nowrap;
  }

  .iq {
    color: var(--iq-green);
  }

  .xl {
    font-size: var(--heading-l-size);
    line-height: var(--heading-l-line);

    @include bp.up(sm) {
      font-size: var(--heading-xl-size);
      line-height: var(--heading-xl-line);
    }
  }
</style>
