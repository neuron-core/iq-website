---
import LinkedText, { type TextWithLinks } from './LinkedText.astro';

/** A plain line, with optional inline links, or a line with a muted detail on its right */
export type BulletItem = TextWithLinks | { text: string; detail: string };

interface Props {
  items: BulletItem[];
  /** Hollow squares: the side of a comparison you leave behind */
  muted?: boolean;
  /** Rules above the first item and below the last */
  ruled?: boolean;
  /** l: items set as small headings */
  size?: 'm' | 'l';
}

const { items, muted = false, ruled = false, size = 'm' } = Astro.props;

// Each line sits in a span, so its text and links stay one flex item beside the bullet
---

<ul class:list={['list', { muted, ruled, l: size === 'l' }]}>
  {
    items.map((item) =>
      typeof item === 'string' || Array.isArray(item) ? (
        <li>
          <span>
            <LinkedText text={item} />
          </span>
        </li>
      ) : (
        <li>
          <span class="line">
            <span>{item.text}</span>
            <span class="detail">{item.detail}</span>
          </span>
        </li>
      ),
    )
  }
</ul>

<style lang="scss">
  .list > li {
    display: flex;
    gap: var(--s-12);
    padding-block: var(--s-12);
    border-bottom: var(--border-width-hairline) solid var(--border-soft);
    color: var(--text-primary);

    &:last-child {
      border-bottom: 0;
    }

    &::before {
      content: "";
      flex: none;
      width: var(--s-8);
      height: var(--s-8);
      margin-top: var(--s-10);
      background: var(--brand);
    }
  }

  .muted > li::before {
    border: var(--border-width-hairline) solid var(--text-subtle);
    background: transparent;
  }

  .ruled {
    border-top: var(--border-width-hairline) solid var(--border-soft);

    > li:last-child {
      border-bottom: var(--border-width-hairline) solid var(--border-soft);
    }
  }

  .l > li {
    padding-block: var(--s-16);
    color: var(--text-strong);
    font-size: var(--heading-xs-size);
    font-weight: var(--font-weight-medium);
    line-height: var(--heading-xs-line);
  }

  // The text and its detail share the line, and the detail wraps under the text when narrow
  .line {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4) var(--s-16);
  }

  .detail {
    color: var(--text-subtle);
    font-size: var(--paragraph-m-size);
    font-weight: var(--font-weight-regular);
    line-height: var(--paragraph-m-line);
  }

  .l .detail {
    font-size: var(--paragraph-l-size);
    line-height: var(--paragraph-l-line);
  }
</style>
