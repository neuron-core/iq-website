---
interface Props {
  as?: 'div' | 'li' | 'article';
  /** A strong rule on top: the product color (green, blue for Premium), or ink */
  accent?: 'brand' | 'ink';
  /** A pale ground in the product color instead of the border */
  brand?: boolean;
  /** A Neuron IQ Premium card: its accents turn Premium blue */
  product?: 'premium';
  /** The space between the card's parts */
  gap?: 'm' | 'l';
  class?: string;
}

const { as: Tag = 'div', accent, brand = false, product, gap = 'm', class: className } = Astro.props;
---

<Tag
  class:list={['card', accent && `accent-${accent}`, { brand, 'gap-l': gap === 'l' }, className]}
  data-product={product}
>
  <slot />
</Tag>

<style lang="scss">
  @use "../styles/variables/breakpoints" as bp;

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-16);
    padding: var(--s-24);
    border: var(--border-width-hairline) solid var(--border-soft);
    border-radius: var(--r-0);
    background: var(--bg-primary);

    @include bp.up(sm) {
      padding: var(--s-28);
    }
  }

  .gap-l {
    gap: var(--s-24);
  }

  .brand {
    border-color: transparent;
    background: var(--bg-brand-weak);
  }

  .accent-brand {
    border-top: var(--border-width-strong) solid var(--brand);
  }

  .accent-ink {
    border-top: var(--border-width-strong) solid var(--text-strong);
  }
</style>
