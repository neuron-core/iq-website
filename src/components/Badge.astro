---
interface Props {
  /** Outlined in the product color (green, blue for Premium), e.g. "Priority" */
  brand?: boolean;
}

const { brand = false } = Astro.props;
---

<span class:list={['badge', { brand }]}><slot /></span>

<style lang="scss">
  .badge {
    display: inline-flex;
    align-items: center;
    padding: var(--s-4) var(--s-8);
    border-radius: var(--r-0);
    background: var(--bg-soft);
    color: var(--text-strong);
    font-family: var(--font-pixel);
    font-size: var(--pixel-m-size);
    font-weight: var(--font-weight-regular);
    line-height: var(--pixel-m-line);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand {
    background: transparent;
    border: var(--border-width-hairline) solid currentColor;
    color: var(--text-brand);
  }
</style>
