---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['container', className]}><slot /></div>

<style lang="scss">
  .container {
    width: 100%;
    max-width: calc(var(--max-width) + var(--s-24) * 2);
    margin-inline: auto;
    padding-inline: var(--s-24);
  }
</style>
