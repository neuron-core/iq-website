---
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '../images/neuron-iq-logo-dark.svg';
import { SITE_NAME, SOCIAL_IMAGE } from '../consts/site';

interface Props {
  title: string;
  description: string;
  /** A product page: its accents take the product's color. Header and footer stay Neuron IQ. */
  product?: 'premium';
}

const { title, description, product } = Astro.props;

// Social cards need full URLs, built on the `site` set in astro.config.mjs
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(SOCIAL_IMAGE.path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Social cards: Open Graph, read by X too -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
    <meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="site">
      <Header />
      <main data-product={product}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style lang="scss">
  .site {
    overflow-x: clip;
  }
</style>
